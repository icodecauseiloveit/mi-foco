# ─── Mi Foco · asistente con IA (opcional) ───
# Copia este archivo como .env (en la misma carpeta que app.py), pon tu clave y reinicia Mi Foco.
# El archivo .env no se sube a GitHub (está en .gitignore).

# Obligatoria para activar los botones ✨. Se crea en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Opcionales
# Modelo a usar (por defecto gpt-5-mini).
#OPENAI_MODEL=gpt-5-mini
# Esfuerzo de razonamiento: minimal | low | medium | high (por defecto low). Déjalo vacío si tu modelo no lo admite.
#OPENAI_REASONING_EFFORT=low
# Una o dos frases sobre tu trabajo, para que las respuestas usen tus términos.
#MIFOCO_CONTEXTO=Programador del área PAP; apoyo la herramienta STO en las paradas de planta del PHD.
# Hora en que termina tu jornada (para «Planear mi día»).
#MIFOCO_FIN_JORNADA=17:00
